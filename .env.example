# Summaries and chat go through Vercel AI Gateway.
#
# On Vercel: nothing to set. Deployments authenticate to AI Gateway with OIDC.
# Locally: run `vercel link && vercel env pull` (writes a short-lived
# VERCEL_OIDC_TOKEN to .env.local), or create a gateway key and set:
AI_GATEWAY_API_KEY=

# Optional, local single-user only: also persist the feed list to data/feeds.json.
# Never enable on a shared deployment (the endpoint has no auth).
FEEDS_FILE_STORAGE=false
